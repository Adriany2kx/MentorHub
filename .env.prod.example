# Production environment template for Digital Ocean deployment
# Copy this file to .env.prod and fill in the required values

# Database
DB_USER=final_project
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_NAME=final_project

# Frontend URL (used for CORS and cookie settings)
FRONTEND_URL=https://yourdomain.com

# Session and Security
SESSION_SECRET=GENERATE_A_RANDOM_STRING_MINIMUM_32_CHARACTERS_LONG
RECAPTCHA_SECRET_KEY=YOUR_GOOGLE_RECAPTCHA_SECRET_KEY

# Email (SMTP) - SendGrid
EMAIL_FROM=your-verified-sender@yourdomain.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.YOUR_SENDGRID_API_KEY_HERE

# AI Integration (Google Gemini)
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# Nginx
NGINX_HOST=yourdomain.com

# Node Environment (keep as production)
NODE_ENV=production
