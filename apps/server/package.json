{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "npm run db:seed:small",
    "db:seed:small": "tsx scripts/seed-local.ts --profile=small",
    "db:seed:medium": "tsx scripts/seed-local.ts --profile=medium",
    "db:seed:large": "tsx scripts/seed-local.ts --profile=large",
    "db:seed:legacy": "tsx scripts/seed-complete.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^10.60.0",
    "argon2": "^0.43.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "resend": "^4.5.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.5.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
